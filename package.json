{
  "name": "corto",
  "productName": "Corto",
  "private": true,
  "version": "0.1.1",
  "description": "A local, account-free home video and slideshow maker for Windows, macOS, Linux and the web.",
  "author": "itsdanielyc <itsdanielyc@users.noreply.github.com>",
  "license": "MIT",
  "type": "module",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite",
    "typecheck": "tsc --noEmit && tsc -p electron/tsconfig.json && tsc -p tests/tsconfig.json",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "package": "npm run build && electron-builder --publish never",
    "test:unit": "vitest run",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "test:ui": "playwright test",
    "test:ui:update": "cross-env UPDATE_SNAPSHOTS=1 playwright test --update-snapshots=all",
    "test:e2e": "playwright test -c playwright.e2e.config.ts",
    "contact-sheet": "node scripts/contact-sheet.mjs",
    "triage": "node scripts/triage.mjs",
    "build:web": "npm run typecheck && vite build && node scripts/build-service-worker.mjs",
    "preview:web": "vite preview",
    "test:web": "playwright test -c playwright.web.config.ts",
    "format": "prettier --write src electron contracts tests scripts *.ts *.json *.yml index.html",
    "postinstall": "node scripts/verify-ffmpeg.mjs && node scripts/prepare-codecs.mjs",
    "predev": "node scripts/prepare-codecs.mjs",
    "predev:web": "node scripts/prepare-codecs.mjs",
    "prebuild": "node scripts/prepare-codecs.mjs",
    "prebuild:web": "node scripts/prepare-codecs.mjs",
    "test:installers": "node scripts/test-installers.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/dm-serif-display": "5.3.0",
    "@huggingface/transformers": "^4.3.2",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cross-env": "^10.1.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "exifr": "^7.1.3",
    "ffmpeg-static": "5.3.0",
    "libheif-js": "1.23.5",
    "lucide-react": "1.73.0",
    "prettier": "3.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.1.0",
    "webm-duration-fix": "1.0.4"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "homepage": "https://itsdanielyc.github.io/corto/",
  "repository": {
    "type": "git",
    "url": "https://github.com/itsdanielyc/corto.git"
  },
  "overrides": {
    "minimatch": "11.0.8"
  }
}
